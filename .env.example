# AWS credentials are resolved through the standard AWS chain (aws configure / IAM role),
# not through this file.
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Used by the evaluation harness (evaluation/config.py)
S3_BUCKET_NAME=bedrock-workflow-screenshots

LOG_LEVEL=DEBUG
ENV=development
